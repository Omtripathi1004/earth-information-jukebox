# Earth Information Jukebox Environment Configuration

# -----------------------------------------------------------------------------
# Optional Third-Party API Tokens (Free)
# -----------------------------------------------------------------------------
# Mapillary Client Token for real street-level photos
# Get a free token at: https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Cesium ion Access Token for Google Photorealistic 3D Tiles
# Get a free token at: https://ion.cesium.com
CESIUM_ION_TOKEN=

# ElevenLabs API Key for AI narration
# Get a token at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# Upstream Client Identification
# -----------------------------------------------------------------------------
# Contact email or repo URL sent in the User-Agent header to NASA GIBS, POWER & OSM Nominatim
JUKEBOX_CONTACT=earth-information-jukebox/1.0 (https://github.com/Omtripathi1004/earth-information-jukebox)

# -----------------------------------------------------------------------------
# Server Settings (Local Development)
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
